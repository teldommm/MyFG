// SDR -> HDR10 (BT.2020 + PQ, full range). Один проход на выходной кадр: RGBA8 sRGB-кадр -> PQ-кадр того же размера.
//   1. контраст — S-кривая по закодированному значению (чёрное и белое неподвижны);
//   2. линеаризация: sRGB (gamma=0) или степень gamma (2.2 по умолчанию; больше — глубже тени);
//   3. насыщенность — вокруг яркости BT.709;
//   4. 1.0 SDR = paper white (hdr_pw нит); света выше колена (hdr_knee) растягиваются к пику панели
//      (hdr_peak) на hdr_boost % от доступного запаса, цвет сохраняется (один общий множитель на пиксель);
//   5. BT.709 -> BT.2020, кодирование ST 2084 (PQ). Для 8-битного вывода добавляется треугольный дизеринг.
// Слой помечается dataspace BT2020_PQ (0x09c60000), см. pipeline.cpp.
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D ps0;
#ifdef FMT_10
layout(set = 0, binding = 1, rgb10_a2) uniform writeonly image2D dstImg;
#else
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dstImg;
#endif

layout(push_constant) uniform PC {
    vec4 a;     // x = paper white (нит), y = пик панели (нит), z = колено 0..1, w = boost 0..1
    vec4 b;     // x = gamma (<0.5 = sRGB), y = контраст 0.5..1.5, z = насыщенность 0.5..1.5, w = seed дизеринга
    uvec2 sz;   // размер кадра
} pc;

vec3 srgbToLinear(vec3 c) {
    bvec3 lo = lessThanEqual(c, vec3(0.04045));
    return mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, lo);
}

vec3 pqEncode(vec3 y) {            // y = нит / 10000 (покомпонентно)
    const float m1 = 0.1593017578125;
    const float m2 = 78.84375;
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;
    vec3 p = pow(clamp(y, vec3(0.0), vec3(1.0)), vec3(m1));
    return pow((c1 + c2 * p) / (1.0 + c3 * p), vec3(m2));
}

// Целочисленный PCG-подобный хэш вместо sin/fract: тот же равномерный шум [0,1),
// но без двух трансцендентных функций на пиксель (актуально только для 8-битного дизеринга).
float ihash(uvec2 p, uint s) {
    uint h = (p.x * 197u) ^ (p.y * 60493u) ^ (s * 9973u);
    h = (h ^ (h >> 16u)) * 1274126177u;
    h ^= h >> 16u;
    return float(h) * (1.0 / 4294967295.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.sz.x) || p.y >= int(pc.sz.y)) return;

    vec3 c = texelFetch(ps0, p, 0).rgb;

    // 1. контраст: v' = v + t*2*(smooth(v) - v); t = ct-1 в [-0.5, 0.5]; монотонно на всём диапазоне
    float t = pc.b.y - 1.0;
    vec3 sm = c * c * (3.0 - 2.0 * c);
    c = clamp(c + (2.0 * t) * (sm - c), 0.0, 1.0);

    // 2. линеаризация
    vec3 l = pc.b.x < 0.5 ? srgbToLinear(c) : pow(c, vec3(pc.b.x));

    // 3. насыщенность
    float Y = dot(l, vec3(0.2126, 0.7152, 0.0722));
    l = max(vec3(Y) + (l - vec3(Y)) * pc.b.z, 0.0);

    // 4. paper white и растяжение светов
    float peak = pc.a.y;
    float pw = min(pc.a.x, peak);
    float knee = pc.a.z;
    float m = max(l.r, max(l.g, l.b));
    float k = clamp((m - knee) / max(1.0 - knee, 1e-3), 0.0, 1.0);
    float room = max(peak / pw - 1.0, 0.0);
    float gain = 1.0 + pc.a.w * room * k * k;
    vec3 nits = l * (pw * gain);
    float mx = max(nits.r, max(nits.g, nits.b));
    if (mx > peak) nits *= peak / mx;

    // 5. BT.709 -> BT.2020 (столбцы матрицы), PQ
    const mat3 M = mat3(0.6274039, 0.0690973, 0.0163914,
                        0.3292830, 0.9195404, 0.0880133,
                        0.0433131, 0.0113623, 0.8955953);
    vec3 rgb2020 = M * nits;
    vec3 pq = pqEncode(rgb2020 / 10000.0);

#ifndef FMT_10
    uvec2 up = uvec2(gl_GlobalInvocationID.xy);
    uint seed = floatBitsToUint(pc.b.w);
    float n = ihash(up, seed) + ihash(up, seed ^ 0x9e3779b9u) - 1.0;   // треугольный шум, ±1 LSB
    pq = clamp(pq + n / 255.0, vec3(0.0), vec3(1.0));
#endif
    imageStore(dstImg, p, vec4(pq, 1.0));
}
